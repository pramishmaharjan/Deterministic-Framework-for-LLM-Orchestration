# Surgical Brain OS - System Environment Configuration

# --- API KEYS ---
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# --- SYSTEM PATHS ---
# This is the 'Disk' of the Brain.
# The installer will create a default at ~/SurgicalBrain/Work
BRAIN_ROOT_PATH=C:/SurgicalBrain/Work

# The Sovereign State specification file
SOVEREIGN_STATE_PATH=config/sovereign_state.md

# --- SYSTEM SETTINGS ---
LOG_LEVEL=DEBUG
DETERMINISTIC_MODE=True
